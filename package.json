{
  "name": "akoto-yves-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run validate:content && astro check && astro build && tsx scripts/build-search.ts",
    "preview": "astro preview",
    "check": "astro check",
    "validate:content": "tsx scripts/validate-content.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-astro"
    ]
  },
  "dependencies": {
    "@astrojs/mdx": "8.0.1",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.3.3",
    "pagefind": "1.5.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "prettier": "3.7.4",
    "prettier-plugin-astro": "^1.1.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "yaml": "2.9.1"
  }
}
