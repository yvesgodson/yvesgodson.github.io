---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogList from "../../components/BlogList.astro";
import Pagination from "../../components/Pagination.astro";
import BlogSearch from "../../components/BlogSearch.astro";
import EmptyState from "../../components/EmptyState.astro";
import { getPublicEntries } from "../../lib/content";
import { tagLabels } from "../../data/site";
import { withBase } from "../../lib/routes";

const entries = await getPublicEntries("blog");
const tags = Array.from(
  new Set(entries.flatMap((entry) => entry.data.tags)),
).sort();
const pages = Math.ceil(entries.length / 10);
---

<BaseLayout
  title="Blog"
  description="Technical notes and articles published by Yves Akoto."
  currentPath={Astro.url.pathname}
>
  <section class="page-head" aria-labelledby="blog-title">
    <p class="page-head__eyeline">Blog</p>
    <h1 class="page-title" id="blog-title">
      Blog
    </h1>
    <p class="page-head__intro">
      My writing on computer science, AI, and what I learn.
    </p>
    {tags.length > 0 && (
      <ul class="tag-list" aria-label="Tags">
        {tags.map((tag) => (
          <li>
            <a href={withBase(`/blog/tags/${tag}/`)}>{tagLabels[tag]}</a>
          </li>
        ))}
      </ul>
    )}
  </section>
  <section
    class="page-section--tight"
    aria-label="Blog articles"
    data-pagefind-ignore
  >
    {entries.length > 0 && <BlogSearch />}
    {entries.length ? (
      <BlogList entries={entries.slice(0, 10)} />
    ) : (
      <EmptyState>No posts yet.</EmptyState>
    )}
    <Pagination basePath={`/blog`} page={1} total={pages} />
  </section>
</BaseLayout>
