---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import BlogList from "../../../components/BlogList.astro";
import Pagination from "../../../components/Pagination.astro";
import { getPublicEntries } from "../../../lib/content";

export async function getStaticPaths() {
  const entries = await getPublicEntries("blog");
  const total = Math.ceil(entries.length / 10);
  return Array.from({ length: Math.max(0, total - 1) }, (_, index) => {
    const page = index + 2;
    return {
      params: { page: String(page) },
      props: {
        entries: entries.slice((page - 1) * 10, page * 10),
        page,
        total,
      },
    };
  });
}

const { entries, page, total } = Astro.props as {
  entries: CollectionEntry<"blog">[];
  page: number;
  total: number;
};
---

<BaseLayout
  title={`Blog, page ${page}`}
  description="Blog articles by Yves Akoto."
  currentPath={Astro.url.pathname}
>
  <section class="page-head" aria-labelledby="blog-title">
    <p class="page-head__eyeline">Blog</p>
    <h1 class="page-title" id="blog-title">
      Articles, page {page}.
    </h1>
  </section>
  <section
    class="page-section--tight"
    aria-label="Blog articles"
    data-pagefind-ignore
  >
    <BlogList entries={entries} />
    <Pagination basePath={`/blog`} page={page} total={total} />
  </section>
</BaseLayout>
