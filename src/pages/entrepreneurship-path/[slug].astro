---
import { render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatPeriod, getPublicEntries } from "../../lib/content";
import { withBase } from "../../lib/routes";

export async function getStaticPaths() {
  const entries = await getPublicEntries("journey");
  return entries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props as { entry: CollectionEntry<"journey"> };
const { Content } = await render(entry);
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.summary}
  currentPath={Astro.url.pathname}
>
  <div class="article-layout">
    <article class="prose">
      <p class="article-meta">
        {formatPeriod(entry.data.periodStart, entry.data.periodEnd)}
      </p>
      <h1>{entry.data.title}</h1>
      <p>{entry.data.summary}</p>
      <dl class="detail-facts">
        <div>
          <dt>Initiative</dt>
          <dd>{entry.data.initiative}</dd>
        </div>
        <div>
          <dt>Decision</dt>
          <dd>{entry.data.decision}</dd>
        </div>
        <div class="detail-facts__wide">
          <dt>Learning</dt>
          <dd>{entry.data.learning}</dd>
        </div>
      </dl>
      <Content />
      <a class="article-return" href={withBase("/entrepreneurship-path/")}>
        Back to path
      </a>
    </article>
  </div>
</BaseLayout>
