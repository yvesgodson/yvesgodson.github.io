---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EmptyState from "../../components/EmptyState.astro";
import { formatPeriod, getPublicEntries } from "../../lib/content";
import { withBase } from "../../lib/routes";

const entries = await getPublicEntries("journey");
---

<BaseLayout
  title="Entrepreneurship path"
  description="Entrepreneurship path notes by Yves Akoto."
  currentPath={Astro.url.pathname}
>
  <section class="page-head" aria-labelledby="journey-title">
    <p class="page-head__eyeline">Entrepreneurship path</p>
    <h1 class="page-title" id="journey-title">
      Initiatives in context.
    </h1>
    <p class="page-head__intro">
      This timeline only publishes material documented well enough to share.
    </p>
  </section>
  <section
    class="page-section--tight"
    aria-label="Path notes"
    data-pagefind-ignore
  >
    {entries.length ? (
      <ul class="content-list">
        {entries.map((entry) => (
          <li class="content-list__item">
            <a
              class="content-list__link"
              href={withBase(`/entrepreneurship-path/${entry.data.slug}/`)}
            >
              <div>
                <h2 class="content-list__title">{entry.data.title}</h2>
                <p class="content-list__summary">{entry.data.summary}</p>
              </div>
              <span class="content-list__meta">
                {formatPeriod(entry.data.periodStart, entry.data.periodEnd)}
              </span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <EmptyState>
        Path notes will be published as they are documented.
      </EmptyState>
    )}
  </section>
</BaseLayout>
